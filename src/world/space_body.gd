@tool
class_name SpaceBody
extends StaticBody3D

## Base class for static objects in space: asteroids, stations, gates.
##
## Every SpaceBody is a sphere of `radius` for navigation; ships fly around it. By default the
## collision shape is the same sphere; structures override _build_collision() with their real
## shape, so ships can get inside the sphere through corridors.
## Visuals are placeholder geometry generated by _build_visuals() from exported parameters,
## so changing a value in the inspector rebuilds the object right away (also in the editor).
## Generated children are not saved with the scene. Visuals must fit inside the sphere.
##
## Corridors are straight lanes into a structure (docking ports, gate throats). A ship waits at
## the corridor's `hold` point, flies in to `inner` once the corridor is reserved for it, and
## leaves along inner -> `outer`. Only one ship at a time may use a corridor.

@export var display_name := "Object":
	set(value):
		display_name = value
		_queue_rebuild()
## Collision and avoidance radius in meters.
@export var radius := 40.0:
	set(value):
		radius = maxf(value, 1.0)
		_queue_rebuild()
@export var show_label := true:
	set(value):
		show_label = value
		_queue_rebuild()

## Corridor lock key -> {ship, order} of the current user.
var _corridor_locks := {}


func _ready() -> void:
	add_to_group(Autopilot.OBSTACLE_GROUP)
	_rebuild()


func get_nav_radius() -> float:
	return radius


## Override to build the visuals with add_generated() and add_mesh().
func _build_visuals() -> void:
	pass


## Override to replace the default collision sphere with the real shape of a structure.
func _build_collision() -> void:
	var shape := SphereShape3D.new()
	shape.radius = radius
	add_shape(shape)


# --- Corridors -------------------------------------------------------------------------------

func get_corridor_count() -> int:
	return 0


## Override: corridor points in local space as [inner, outer, hold].
func _corridor_local(_index: int) -> Array[Vector3]:
	return []


## Corridor points in global space: {inner, outer, hold}.
func get_corridor(index: int) -> Dictionary:
	var points := _corridor_local(index)
	return {
		"inner": to_global(points[0]),
		"outer": to_global(points[1]),
		"hold": to_global(points[2]),
	}


## Index of the corridor whose holding point is closest to `point`.
func nearest_corridor(point: Vector3) -> int:
	var best := 0
	var best_distance := INF
	for i in get_corridor_count():
		var distance := point.distance_to(get_corridor(i)["hold"])
		if distance < best_distance:
			best_distance = distance
			best = i
	return best


## Reserves a corridor for `ship` while it executes `order`. The reservation lapses on its own
## if the ship disappears or switches to another order, so a lost ship never blocks a corridor.
func try_reserve_corridor(index: int, ship: Ship, order: ShipOrder) -> bool:
	var key := _lock_key(index)
	var lock: Dictionary = _corridor_locks.get(key, {})
	if not lock.is_empty() and lock["ship"] != ship:
		var owner_ship = lock["ship"]
		if is_instance_valid(owner_ship) and owner_ship.current_order == lock["order"]:
			return false
	_corridor_locks[key] = {"ship": ship, "order": order}
	return true


func release_corridor(index: int, ship: Ship) -> void:
	var key := _lock_key(index)
	var lock: Dictionary = _corridor_locks.get(key, {})
	if not lock.is_empty() and lock["ship"] == ship:
		_corridor_locks.erase(key)


## Corridors sharing a lock key cannot be used at the same time (e.g. both sides of a gate
## lead to the same throat). By default every corridor is independent.
func _lock_key(index: int) -> int:
	return index


func _queue_rebuild() -> void:
	if is_node_ready():
		_rebuild()


func _rebuild() -> void:
	for child in get_children():
		if child.has_meta(&"generated"):
			remove_child(child)
			child.queue_free()

	_build_visuals()
	_build_collision()
	if show_label:
		add_generated(SpaceLabel.create(display_name, radius))


func add_shape(shape: Shape3D, local_transform := Transform3D.IDENTITY) -> CollisionShape3D:
	var collision := CollisionShape3D.new()
	collision.shape = shape
	collision.transform = local_transform
	add_generated(collision)
	return collision


## Adds a generated child to this body, or to `parent` (itself a generated node or its child).
func add_generated(node: Node3D, parent: Node3D = null) -> Node3D:
	if parent == null:
		node.set_meta(&"generated", true)
		add_child(node)
	else:
		parent.add_child(node)
	return node


func add_mesh(mesh: Mesh, material: Material, at := Vector3.ZERO,
		parent: Node3D = null) -> MeshInstance3D:
	var instance := MeshInstance3D.new()
	instance.mesh = mesh
	instance.material_override = material
	instance.position = at
	add_generated(instance, parent)
	return instance


static func make_material(color: Color, metallic := 0.3, roughness := 0.6) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.metallic = metallic
	material.roughness = roughness
	return material


## Unshaded glowing material for lights and engine flares.
static func make_glow_material(color: Color, energy := 3.0) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	material.albedo_color = color
	material.emission_enabled = true
	material.emission = color
	material.emission_energy_multiplier = energy
	return material


static func cylinder(top_radius: float, bottom_radius: float, height: float,
		segments := 24) -> CylinderMesh:
	var mesh := CylinderMesh.new()
	mesh.top_radius = top_radius
	mesh.bottom_radius = bottom_radius
	mesh.height = height
	mesh.radial_segments = segments
	mesh.rings = 1
	return mesh


static func box(size: Vector3) -> BoxMesh:
	var mesh := BoxMesh.new()
	mesh.size = size
	return mesh


static func sphere(sphere_radius: float) -> SphereMesh:
	var mesh := SphereMesh.new()
	mesh.radius = sphere_radius
	mesh.height = sphere_radius * 2.0
	mesh.radial_segments = 12
	mesh.rings = 6
	return mesh
